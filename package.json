{
  "name": "n8forged-shopify-theme",
  "version": "0.3.0",
  "private": true,
  "description": "Canonical Shopify theme for N8Forged",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "shopify:login": "shopify auth login",
    "theme:check": "shopify theme check",
    "theme:dev": "shopify theme dev --store n8forged.myshopify.com",
    "theme:list": "shopify theme list --store n8forged.myshopify.com",
    "audit:catalog": "node scripts/audit-printify-shopify.mjs",
    "sync:media-maps": "node scripts/sync-printify-media-maps.mjs",
    "test:media-maps": "node --test scripts/lib/media-color-map.test.mjs"
  },
  "devDependencies": {
    "@shopify/cli": "4.5.1"
  }
}
