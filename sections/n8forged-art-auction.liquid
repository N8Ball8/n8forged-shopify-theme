{{ 'n8forged-auction.css' | asset_url | stylesheet_tag }}
<script src="{{ 'n8forged-auction.js' | asset_url }}" defer="defer"></script>

<n8forged-auction
  class="n8f-auction"
  data-api-url="{{ section.settings.api_url | escape }}"
  data-publishable-key="{{ section.settings.publishable_key | escape }}"
  data-auction-id="{{ section.settings.auction_id | escape }}"
  data-ends-at="{{ section.settings.ends_at | escape }}"
>
  <div class="n8f-auction__test-banner" role="status">
    <span>PRIVATE FAMILY TEST — NOT A LIVE AUCTION. All test bids will be erased.</span>
    <a href="mailto:N8Darby@gmail.com?subject=N8Forged%20Auction%20Test%20-%20Bug%20or%20Enhancement%20Request">Log Bug / Enhancement Request</a>
  </div>
  <header class="n8f-auction__hero">
    <div class="n8f-auction__shell n8f-auction__hero-grid">
      <div>
        <p class="n8f-auction__eyebrow">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading }}</h1>
        <div class="n8f-auction__intro">{{ section.settings.introduction }}</div>
        <div class="n8f-auction__impact">
          <strong>100% supports our family’s Costa Rica mission trip.</strong>
          <span>Painted and generously donated by Andrea.</span>
        </div>
      </div>

      <div class="n8f-auction__clock">
        <div class="n8f-auction__clock-label">
          <span><i class="n8f-auction__status-dot"></i>Family test active</span>
          <span>Central Time</span>
        </div>
        <div class="n8f-auction__countdown" data-auction-countdown aria-label="Time remaining">
          <div><strong data-days>00</strong><span>Days</span></div>
          <div><strong data-hours>00</strong><span>Hours</span></div>
          <div><strong data-minutes>00</strong><span>Minutes</span></div>
          <div><strong data-seconds>00</strong><span>Seconds</span></div>
        </div>
        <p class="n8f-auction__close-copy" data-auction-deadline>
          Scheduled to close August 15, 2026 at 8:00 PM Central. A bid in the final five minutes extends bidding by five minutes.
        </p>
      </div>
    </div>
  </header>

  <div class="n8f-auction__shell n8f-auction__main">
    <div class="n8f-auction__gallery" aria-label="Artwork gallery">
      <button class="n8f-auction__media" type="button">
        <img
          src="{{ 'joy-in-our-chains-01.jpg' | asset_url }}"
          alt="Joy in Our Chains by Andrea Darby, full artwork"
          loading="eager"
          width="1400"
          height="938"
          data-auction-image
          data-auction-gallery
        >
      </button>
      <div hidden data-auction-gallery-sources>
        {% for image_number in (1..8) %}
          {% assign padded_number = image_number | prepend: '0' %}
          {% assign gallery_asset = 'joy-in-our-chains-' | append: padded_number | append: '.jpg' %}
          <span data-gallery-source="{{ gallery_asset | asset_url }}"></span>
        {% endfor %}
      </div>
    </div>

    <aside>
      <div class="n8f-auction__bid-card">
        <div class="n8f-auction__bid-card-header">
          <p class="n8f-auction__price-label">Current bid</p>
          <a class="n8f-auction__bid-history-link" href="#AuctionBidHistory">Bid History</a>
        </div>
        <div class="n8f-auction__price" data-current-price>$0</div>
        <span class="n8f-auction__reserve" data-reserve-status data-met="false">○ Reserve not met</span>

        <div class="n8f-auction__identity" data-bidder-identity data-status="signed-out">
          <strong>Sign in through a secure email link to bid.</strong><br>
          Your Auction Nickname is the only identity shown publicly.
        </div>
        <p class="n8f-auction__active" data-active-bidders hidden></p>
        <button class="n8f-auction__button n8f-auction__button--secondary" type="button" data-open-registration>
          Register or sign in
        </button>
        <button class="n8f-auction__button" type="button" data-quick-bid data-bid-control>
          Bid $10 more
        </button>

        <div class="n8f-auction__current-max" data-current-max hidden>
          <span>Your current Maximum Bid</span>
          <strong data-current-max-amount></strong>
          <small>Only you can see this amount.</small>
        </div>

        <form data-max-bid-form novalidate>
          <div class="n8f-auction__field">
            <label for="AuctionMaximumBid" data-max-bid-label>Maximum Bid (USD)</label>
            <input
              id="AuctionMaximumBid"
              name="maximum_bid"
              type="number"
              min="10"
              step="10"
              inputmode="numeric"
              placeholder="Enter a maximum"
              data-bid-control
              required
            >
            <small>Your maximum stays private. We bid only enough to keep you ahead in $10 increments. If two maximums are equal, the bidder who reached that amount first stays ahead.</small>
          </div>
          <button class="n8f-auction__button n8f-auction__button--secondary" type="submit" data-bid-control data-max-bid-submit>
            Set Maximum Bid
          </button>
        </form>

        <p class="n8f-auction__feedback" data-auction-feedback aria-live="polite"></p>
        <p class="n8f-auction__helper">
          Bidders must be 18 or older. Bids are binding. Winner pays in USD through Shopify within 48 hours.
        </p>
        <button class="n8f-auction__button n8f-auction__button--secondary" type="button" data-auction-logout hidden>
          Log out
        </button>
      </div>
    </aside>
  </div>

  <section class="n8f-auction__section">
    <div class="n8f-auction__shell n8f-auction__story-grid">
      <div>
        <p class="n8f-auction__kicker">The artwork</p>
        <h2>Joy in Our Chains</h2>
        <dl class="n8f-auction__art-details">
          <div><dt>Artist</dt><dd>Andrea Darby</dd></div>
          <div><dt>Completed</dt><dd>2023</dd></div>
          <div><dt>Medium</dt><dd>Acrylic / Mixed Media on Canvas</dd></div>
          <div><dt>Dimensions</dt><dd>24 × 36 × ¾ inches</dd></div>
          <div><dt>Weight</dt><dd>2.6 pounds</dd></div>
          <div><dt>Presentation</dt><dd>Unframed; signed at the bottom right</dd></div>
        </dl>
      </div>
      <div class="n8f-auction__artist-story">
        {{ section.settings.artist_story }}
        <div class="n8f-auction__artist-bio">
          <p class="n8f-auction__kicker">About the artist</p>
          {{ section.settings.artist_bio }}
        </div>
      </div>
    </div>
  </section>

  <section class="n8f-auction__section n8f-auction__admin" data-admin-panel hidden>
    <div class="n8f-auction__shell">
      <p class="n8f-auction__kicker">Administrator only</p>
      <h2>Family test controls</h2>
      <div class="n8f-auction__admin-card">
        <div>
          <h3>Reset and start a fresh 24-hour test</h3>
          <p>This permanently clears test bids, proxy maximums, extensions, queued test emails, winner state, and family test registrations. Your administrator account and final auction settings remain intact.</p>
        </div>
        <button class="n8f-auction__button" type="button" data-reset-test-auction>
          Reset and Start 24-Hour Test
        </button>
      </div>
      <p class="n8f-auction__feedback" data-admin-feedback aria-live="polite"></p>
    </div>
  </section>

  <section class="n8f-auction__section">
    <div class="n8f-auction__shell">
      <div class="n8f-auction__section-heading">
        <div>
          <p class="n8f-auction__kicker">Look closer</p>
          <h2>Explore the hidden story</h2>
        </div>
        <p class="n8f-auction__helper">Select a glowing marker to uncover a detail.</p>
      </div>

      <div class="n8f-auction__discovery" data-art-discovery>
        <div class="n8f-auction__art-map">
          <img
            src="{{ 'joy-in-our-chains-01.jpg' | asset_url }}"
            alt="Joy in Our Chains by Andrea Darby with interactive detail markers"
            width="1400"
            height="938"
            loading="lazy"
          >
          <button class="n8f-auction__hotspot is-active" type="button" style="--hotspot-x: 11.5%; --hotspot-y: 90.5%;" aria-label="Reveal the chains" aria-pressed="true" data-hotspot data-detail-title="Nine links and two wrist holds" data-detail-image="{{ 'joy-in-our-chains-08.jpg' | asset_url }}" data-detail-copy="The chain has nine links and two wrist holds, like the chain Paul wore while attached to soldier guards during his imprisonment—the chain displayed at the Basilica of Saint Paul in Rome."><span>1</span></button>
          <button class="n8f-auction__hotspot" type="button" style="--hotspot-x: 26.1%; --hotspot-y: 58.5%;" aria-label="Reveal the Roman pitcher" aria-pressed="false" data-hotspot data-detail-title="A Roman pitcher" data-detail-image="{{ 'joy-in-our-chains-03.jpg' | asset_url }}" data-detail-copy="The pitcher is styled after a vessel from 61 A.D. Its green patina suggests a living metal and represents Christ. Paul’s chain is attached firmly to it."><span>2</span></button>
          <button class="n8f-auction__hotspot" type="button" style="--hotspot-x: 54.1%; --hotspot-y: 66.4%;" aria-label="Reveal the liquid gold" aria-pressed="false" data-hotspot data-detail-title="Liquid gold poured out" data-detail-image="{{ 'joy-in-our-chains-03.jpg' | asset_url }}" data-detail-copy="The liquid gold recalls Philippians 2:17 and a life poured out as an offering. Even the soldier guards chained to Paul were ministered to by the words of Christ pouring through Paul’s writings."><span>3</span></button>
          <button class="n8f-auction__hotspot" type="button" style="--hotspot-x: 80.4%; --hotspot-y: 10.8%;" aria-label="Reveal the embedded letter" aria-pressed="false" data-hotspot data-detail-title="The entire letter" data-detail-image="{{ 'joy-in-our-chains-07.jpg' | asset_url }}" data-detail-copy="Pieces of the entire book of Philippians are embedded throughout the background of the artwork."><span>4</span></button>
          <button class="n8f-auction__hotspot" type="button" style="--hotspot-x: 77.2%; --hotspot-y: 53.9%;" aria-label="Reveal the journeys between Philippi and Rome" aria-pressed="false" data-hotspot data-detail-title="Journeys between Philippi and Rome" data-detail-image="{{ 'joy-in-our-chains-04.jpg' | asset_url }}" data-detail-copy="The loops represent the trips back and forth between Philippi and Rome by Paul, Timothy, and Epaphroditus."><span>5</span></button>
          <button class="n8f-auction__hotspot" type="button" style="--hotspot-x: 17.4%; --hotspot-y: 7.5%;" aria-label="Reveal the meaning of the red background" aria-pressed="false" data-hotspot data-detail-title="The red background" data-detail-image="{{ 'joy-in-our-chains-05.jpg' | asset_url }}" data-detail-copy="The red background symbolizes the blood of Christ."><span>6</span></button>
          <button class="n8f-auction__hotspot" type="button" style="--hotspot-x: 80.9%; --hotspot-y: 71.7%;" aria-label="Reveal the meaning of the black background" aria-pressed="false" data-hotspot data-detail-title="The black background" data-detail-image="{{ 'joy-in-our-chains-07.jpg' | asset_url }}" data-detail-copy="The black background represents the darkness of imprisonment and the hard times we face in life."><span>7</span></button>
        </div>

        <aside class="n8f-auction__discovery-detail" aria-live="polite">
          <button class="n8f-auction__detail-image" type="button" data-discovery-zoom aria-label="View selected artwork detail full size">
            <img src="{{ 'joy-in-our-chains-08.jpg' | asset_url }}" alt="" width="1400" height="1050" loading="lazy" data-discovery-image>
            <span>Click to view full size ↗</span>
          </button>
          <div class="n8f-auction__detail-copy">
            <p class="n8f-auction__kicker">Hidden detail <span data-discovery-number>01</span></p>
            <h3 data-discovery-title>Nine links and two wrist holds</h3>
            <p data-discovery-copy>The chain has nine links and two wrist holds, like the chain Paul wore while attached to soldier guards during his imprisonment—the chain displayed at the Basilica of Saint Paul in Rome.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="n8f-auction__section" id="AuctionBidHistory">
    <div class="n8f-auction__shell">
      <div class="n8f-auction__section-heading">
        <div>
          <p class="n8f-auction__kicker">Live activity</p>
          <h2>Recent bids</h2>
        </div>
        <button class="n8f-auction__button n8f-auction__button--secondary" type="button" data-view-all-bids hidden>
          View all bids
        </button>
      </div>
      <div class="n8f-auction__bids" data-bid-list>
        <p class="n8f-auction__helper">No bids yet. Be the first to support the mission.</p>
      </div>
    </div>
  </section>

  <section class="n8f-auction__section">
    <div class="n8f-auction__shell">
      <p class="n8f-auction__kicker">Before you bid</p>
      <h2>Auction essentials</h2>
      <div class="n8f-auction__rules">
        {{ section.settings.rules }}
      </div>
    </div>
  </section>

  <dialog class="n8f-auction__lightbox" data-auction-lightbox>
    <button class="n8f-auction__lightbox-close" type="button" aria-label="Close image viewer" data-lightbox-close>×</button>
    <button class="n8f-auction__lightbox-nav n8f-auction__lightbox-nav--previous" type="button" aria-label="Previous image" data-lightbox-previous>‹</button>
    <img src="{{ 'n8forged-mark-approved.png' | asset_url }}" alt="" width="1600" height="1200">
    <button class="n8f-auction__lightbox-nav n8f-auction__lightbox-nav--next" type="button" aria-label="Next image" data-lightbox-next>›</button>
    <p class="n8f-auction__lightbox-count" data-lightbox-count hidden></p>
  </dialog>

  <dialog class="n8f-auction__auth" data-auction-auth>
    <button class="n8f-auction__auth-close" type="button" aria-label="Close registration" data-auth-close>×</button>
      <div data-auth-register>
      <p class="n8f-auction__kicker">Secure bidder access</p>
      <h2>Choose your bidder type</h2>
      <p class="n8f-auction__helper">Have you already registered for this auction?</p>
      <div class="n8f-auction__auth-tabs" role="tablist" aria-label="Bidder access options">
        <button type="button" class="is-active" data-auth-tab="returning">Existing Bidder</button>
        <button type="button" data-auth-tab="new">New Bidder</button>
      </div>
      <form data-returning-form>
        <p class="n8f-auction__auth-choice-title">Existing Bidder Sign In</p>
        <div class="n8f-auction__field">
          <label for="AuctionReturningEmail">Email</label>
          <input id="AuctionReturningEmail" name="email" type="email" autocomplete="email" required>
        </div>
        <p class="n8f-auction__helper">We’ll email you a secure link that returns you here signed in. No password or code needed.</p>
        <button class="n8f-auction__button" type="submit">Email my sign-in link</button>
      </form>
      <div data-new-bidder hidden>
      <p class="n8f-auction__auth-choice-title">New Bidder Registration</p>
      <p class="n8f-auction__helper">Create your private bidder account. Only your Auction Nickname appears publicly.</p>
      <p class="n8f-auction__helper">Your full identity stays private. Only your Auction Nickname appears in public bid history.</p>
      <form data-registration-form>
        <div class="n8f-auction__field">
          <label for="AuctionFullName">Full name</label>
          <input id="AuctionFullName" name="full_name" autocomplete="name" required>
        </div>
        <div class="n8f-auction__field">
          <label for="AuctionNickname">Auction Nickname</label>
          <input id="AuctionNickname" name="nickname" maxlength="32" autocomplete="nickname" required>
          <small>This is the only name other visitors will see. You can change it later from the auction page while signed in.</small>
        </div>
        <div class="n8f-auction__field">
          <label for="AuctionEmail">Email</label>
          <input id="AuctionEmail" name="email" type="email" autocomplete="email" required>
        </div>
        <div class="n8f-auction__field">
          <label for="AuctionPhone">Phone number</label>
          <input id="AuctionPhone" name="phone" type="tel" autocomplete="tel" required>
        </div>
        <label class="n8f-auction__check">
          <input name="age_and_terms" type="checkbox" required>
          <span>I am at least 18 and agree that bids are binding and cannot be changed or withdrawn without administrator approval.</span>
        </label>
        <label class="n8f-auction__check">
          <input name="email_consent" type="checkbox" required>
          <span>I agree to receive verification, bid, outbid, winner, and closing-reminder emails. Optional reminders include an unsubscribe link.</span>
        </label>
        <button class="n8f-auction__button" type="submit">Email my sign-in link</button>
      </form>
      </div>
    </div>

    <div data-auth-verify hidden>
      <p class="n8f-auction__kicker">Check your email</p>
      <h2>Click the link we sent</h2>
      <p class="n8f-auction__helper">We sent a secure sign-in link to <strong data-auth-email></strong>. Click “Confirm and return to the auction” in that email. You will return here signed in and ready to bid.</p>
      <button class="n8f-auction__button" type="button" data-auth-done>Close and check my email</button>
    </div>
    <p class="n8f-auction__feedback" data-auth-feedback aria-live="polite"></p>
  </dialog>

  <dialog class="n8f-auction__auth" data-nickname-dialog>
    <button class="n8f-auction__auth-close" type="button" aria-label="Close nickname editor" data-nickname-close>×</button>
    <p class="n8f-auction__kicker">Auction Nickname</p>
    <h2>Change your public name</h2>
    <p class="n8f-auction__helper">Only your Auction Nickname appears in public bid history. Your full name stays private.</p>
    <form data-nickname-form novalidate>
      <div class="n8f-auction__field">
        <label for="AuctionNicknameChangeCurrent">Current nickname</label>
        <input id="AuctionNicknameChangeCurrent" data-current-nickname readonly>
      </div>
      <div class="n8f-auction__field">
        <label for="AuctionNicknameChange">New nickname</label>
        <input id="AuctionNicknameChange" name="nickname" maxlength="32" autocomplete="nickname" required>
        <small>Keep it clean. This name is visible to other bidders.</small>
      </div>
      <button class="n8f-auction__button" type="submit">Save nickname</button>
    </form>
    <p class="n8f-auction__feedback" data-nickname-feedback aria-live="polite"></p>
  </dialog>

  <dialog class="n8f-auction__confirm" data-bid-confirm>
    <button class="n8f-auction__auth-close" type="button" aria-label="Cancel bid" data-bid-confirm-cancel>×</button>
    <p class="n8f-auction__kicker">Final check</p>
    <h2>Confirm your bid</h2>
    <p class="n8f-auction__confirm-amount" data-bid-confirm-copy></p>
    <div class="n8f-auction__confirm-note">
      <strong>Bids are binding.</strong>
      <span data-bid-confirm-quick>This places one bid at the next $10 increment.</span>
      <span data-bid-confirm-maximum hidden>A Maximum Bid stays private and increases only as needed. Equal maximums favor the bidder who reached that amount first.</span>
    </div>
    <div class="n8f-auction__confirm-actions">
      <button class="n8f-auction__button n8f-auction__button--secondary" type="button" data-bid-confirm-cancel>Go back</button>
      <button class="n8f-auction__button" type="button" data-bid-confirm-submit>Yes, place my bid</button>
    </div>
  </dialog>
</n8forged-auction>

{% schema %}
{
  "name": "N8Forged art auction",
  "tag": "section",
  "class": "n8forged-art-auction-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "N8Forged / Mission Art Auction"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Artwork title",
      "default": "JOY IN OUR CHAINS"
    },
    {
      "type": "richtext",
      "id": "introduction",
      "label": "Introduction",
      "default": "<p>An original acrylic and mixed-media painting by Andrea Darby, created around Paul’s humility and joy while imprisoned. Every dollar from the winning bid supports our family’s Costa Rica mission trip.</p>"
    },
    {
      "type": "richtext",
      "id": "artist_story",
      "label": "Artist story",
      "default": "<p>While writing to God’s people in Philippi, Paul had an attitude of humility and joy in the face of suffering. I too hope to consider others’ needs even when my own life appears hard, knowing Christ is our ultimate source of joy. I hope to continue to be bold for Christ—in life or in death.</p><p><strong>Inspired by Philippians 2:17 and Philippians 1:12–13 (NLT).</strong></p><p>“But I will rejoice even if I lose my life, pouring it out like a liquid offering to God, just like your faithful service is an offering to God. And I want all of you to share that joy.” — Philippians 2:17 NLT</p><p>“And I want you to know, my dear brothers and sisters, that everything that has happened to me here has helped to spread the Good News. For everyone here, including the whole palace guard, knows that I am in chains because of Christ.” — Philippians 1:12–13 NLT</p>"
    },
    {
      "type": "richtext",
      "id": "artist_bio",
      "label": "Artist biography",
      "default": "<p>Andrea Darby is a Northwest Arkansas artist and graduate of the University of Arkansas, where she earned her degree in Art Education. A former high school art teacher with five years in public education and fifteen years in Christian education, she now serves with the Spectra art ministry team at Fellowship Bible Church in NWAR, using art as a form of worship and visual storytelling to complement the church sermons.</p><p>Working across a variety of mediums, Andrea is especially drawn to textured mixed media acrylic and hand-built pottery. Her work is characterized by layered symbolism and tactile surfaces, inviting both visual and physical engagement.</p><p><em>Joy in Our Chains</em> (2023), inspired by Philippians 1–2, reflects the paradox of joy in suffering and a life poured out for Christ. This piece is offered in support of missions, an enduring passion of Andrea’s shaped through many years of active involvement and leadership in international mission work.</p>"
    },
    {
      "type": "text",
      "id": "auction_id",
      "label": "Auction ID",
      "default": "mission-art-2026"
    },
    {
      "type": "text",
      "id": "ends_at",
      "label": "Scheduled end (ISO 8601)",
      "default": "2026-08-16T01:00:00Z",
      "info": "August 15, 2026 at 8:00 PM Central"
    },
    {
      "type": "text",
      "id": "api_url",
      "label": "Auction API URL",
      "default": "https://acvmuapvvkprxncftyev.supabase.co/functions/v1/auction-api",
      "info": "Remove this value to disable registration and bidding."
    },
    {
      "type": "text",
      "id": "publishable_key",
      "label": "Supabase publishable key",
      "default": "sb_publishable_dKo0vIu4tWNIekMVcTmv3g_RZ5Y1qpi",
      "info": "This browser key is public and protected by Row Level Security."
    },
    {
      "type": "richtext",
      "id": "rules",
      "label": "Auction essentials",
      "default": "<p>Bids are placed in $10 increments. The hidden reserve is met when a qualifying Maximum Bid reaches it. Bidding may extend in five-minute intervals. The winner has 48 hours to choose pickup in Little Rock, Arkansas or insured shipping and complete payment. Shipping, packing, insurance, taxes, duties, and customs charges are additional. Full terms are presented during registration.</p>"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Artwork image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alternative text",
          "default": "Original artwork donated for the N8Forged mission auction"
        }
      ]
    },
    {
      "type": "video",
      "name": "Video walkthrough",
      "limit": 1,
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Shopify-hosted video"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "N8Forged art auction"
    }
  ]
}
{% endschema %}
