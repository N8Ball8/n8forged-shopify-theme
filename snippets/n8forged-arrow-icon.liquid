{% liquid
  assign icon_size = size | default: 16
  assign icon_direction = direction | default: 'up-right'
%}

<svg
  class="n8f-arrow-icon n8f-arrow-icon--{{ icon_direction }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 16 16"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {% case icon_direction %}
    {% when 'right' %}
      <path d="M2.5 8h10M8.75 4.25 12.5 8l-3.75 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {% when 'down' %}
      <path d="m3.5 6 4.5 4 4.5-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {% else %}
      <path d="M4 12 12 4M6 4h6v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  {% endcase %}
</svg>
